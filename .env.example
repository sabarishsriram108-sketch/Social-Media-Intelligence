# --- Copywriting (the app works without this, but only mechanically) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Canva Connect API ---
# Create an integration: https://www.canva.com/developers/integrations
# Redirect URL to register: http://127.0.0.1:8910/oauth/redirect
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# --- Optional overrides ---
# PORT=4321
# BRAND_NAME=Onam Cloud
# BRAND_HANDLE=@onamcloud
# BRAND_SITE=onamcloud.com
# CHROMIUM_PATH=/opt/pw-browsers/chromium
