# Canva Connect API - create an integration at
# https://www.canva.com/developers/integrations
# Redirect URL to register: http://127.0.0.1:8910/oauth/redirect
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# Optional: pin a Chromium binary instead of Playwright's download
# CHROMIUM_PATH=/opt/pw-browsers/chromium
